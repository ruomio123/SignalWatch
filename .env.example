APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
# Optional user-accessible site origin for email links; blank links to arXiv.
APP_PUBLIC_URL=
LOG_LEVEL=debug
WORKER_HEARTBEAT=10s

MYSQL_DATABASE=signalwatch
MYSQL_USER=signalwatch
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password
REDIS_PASSWORD=change-me-redis-password

MYSQL_DSN=signalwatch:change-me-app-password@tcp(127.0.0.1:3306)/signalwatch?charset=utf8mb4&parseTime=true&loc=UTC
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0

# Development placeholder only. Replace it with a strong random secret in .env.
JWT_SECRET=development-only-change-me-32-bytes
JWT_TTL=15m
# Fixed browser login lifetime; short access tokens renew automatically.
AUTH_SESSION_TTL=168h
JWT_ISSUER=signalwatch-api

# V2 system-level arXiv ingestion. Bootstrap and recovery use Search API;
# daily discovery runs at 00:30 America/New_York through per-category Atom feeds.
COLLECTOR_LOCK_TTL=55m
ARXIV_BOOTSTRAP_LOOKBACK=168h
ARXIV_RECOVERY_OVERLAP=24h
ARXIV_DAILY_SYNC_TIME=00:30
ARXIV_SYNC_RETRY_INTERVAL=15m
ARXIV_FEED_ENDPOINT=https://rss.arxiv.org/atom
ARXIV_PAGE_SIZE=100
ARXIV_MAX_PAGES=10
ARXIV_MAX_RESPONSE_BYTES=5242880
ARXIV_REQUEST_ATTEMPTS=3
ARXIV_REQUEST_BACKOFF=5s
ARXIV_REQUEST_INTERVAL=3s
ARXIV_HTTP_TIMEOUT=30s

# M3 bounded in-memory matching queue. A full queue blocks arXiv ingestion until
# a matcher worker becomes available.
MATCHER_WORKERS=4
MATCHER_QUEUE_CAPACITY=256

# Retain current/recent operational snapshots in Redis for seven days.
OPS_STATUS_RETENTION=168h

# M4 user-local daily Digest and bounded mail delivery queue.
DIGEST_INTERVAL=1m
MAIL_WORKERS=2
MAIL_QUEUE_CAPACITY=128
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM=SignalWatch <digest@signalwatch.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT=10s

# Optional BYOK AI enrichment. This master key encrypts user-supplied provider
# keys; it is not a provider API key. Generate 32 random bytes and base64 encode.
AI_ENABLED=false
AI_CREDENTIAL_KEYS=
AI_CREDENTIAL_ACTIVE_KEY_VERSION=v1
# Curated direct-provider registry exposed in the preferences page.
AI_ENABLED_PROVIDERS=glm,qwen,deepseek,kimi,openai
AI_WORKERS=2
AI_QUEUE_CAPACITY=128
# Application budgets, not vendor context specifications. Missing models use
# context_tokens=32768 and max_output_tokens=8192. Output cap stays <=8192.
# Example: {"qwen/qwen3.8-flash":{"context_tokens":65536,"max_output_tokens":8192}}
AI_MODEL_LIMITS_JSON={}
# All paper workflow model calls: 10s–120s. Other AI calls retain 30s.
# API and Worker must use the same policy. Overall workflow deadlines still apply.
AI_PAPER_CALL_TIMEOUT=60s

# AI 调用保护：每日上限 0 表示不限；API 与 Worker 必须使用相同策略。
# 间隔范围 1s～1h；每日上限范围 0～1000000，按 UTC 日统计调用尝试。
AI_CONFIG_TEST_MIN_INTERVAL=10s
AI_GENERATION_MIN_INTERVAL=2s
AI_CONFIG_TEST_DAILY_LIMIT=0
AI_PAPER_DAILY_LIMIT=0
AI_DIGEST_DAILY_LIMIT=0

# Agent model calls per user per UTC day; zero means unlimited. Each turn uses at most 4 calls.
AI_SUBSCRIPTION_AGENT_DAILY_LIMIT=0
AI_PAPER_QA_DAILY_LIMIT=0
# Fulltext extraction requires pdftotext, pdfinfo (Poppler) and prlimit on Worker hosts.
