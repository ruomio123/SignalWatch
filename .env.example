APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=debug
WORKER_HEARTBEAT=10s

MYSQL_DATABASE=signalwatch
MYSQL_USER=signalwatch
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password
REDIS_PASSWORD=change-me-redis-password

MYSQL_DSN=signalwatch:change-me-app-password@tcp(127.0.0.1:3306)/signalwatch?charset=utf8mb4&parseTime=true&loc=UTC
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0

# Development placeholder only. Replace it with a strong random secret in .env.
JWT_SECRET=development-only-change-me-32-bytes
JWT_TTL=15m
JWT_ISSUER=signalwatch-api

# V2 system-level arXiv ingestion. Bootstrap and recovery use Search API;
# daily discovery runs at 00:30 America/New_York through per-category Atom feeds.
COLLECTOR_LOCK_TTL=55m
ARXIV_BOOTSTRAP_LOOKBACK=168h
ARXIV_RECOVERY_OVERLAP=24h
ARXIV_DAILY_SYNC_TIME=00:30
ARXIV_SYNC_RETRY_INTERVAL=15m
ARXIV_FEED_ENDPOINT=https://rss.arxiv.org/atom
ARXIV_PAGE_SIZE=100
ARXIV_MAX_PAGES=10
ARXIV_MAX_RESPONSE_BYTES=5242880
ARXIV_REQUEST_ATTEMPTS=3
ARXIV_REQUEST_BACKOFF=5s
ARXIV_REQUEST_INTERVAL=3s
ARXIV_HTTP_TIMEOUT=30s

# M3 bounded in-memory matching queue. A full queue blocks arXiv ingestion until
# a matcher worker becomes available.
MATCHER_WORKERS=4
MATCHER_QUEUE_CAPACITY=256

# M4 user-local daily Digest and bounded mail delivery queue.
DIGEST_INTERVAL=1m
DIGEST_LOCK_TTL=10m
DIGEST_COMPLETION_TTL=72h
MAIL_WORKERS=2
MAIL_QUEUE_CAPACITY=128
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM=SignalWatch <digest@signalwatch.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT=10s

# Optional: dedicated migrated database and Mailpit SMTP address for
# M1-M4/V2 integration acceptance.
# The database name must end in _test; never point this at the development database.
M1_TEST_MYSQL_DSN=
M4_TEST_SMTP_ADDR=127.0.0.1:1025
