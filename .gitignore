# Track application source, build inputs, deployment files and README assets.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/.nvmrc
!/Makefile
!/go.mod
!/go.sum
!/cmd/
!/internal/
!/migrations/
!/deploy/
!/scripts/
!/web/

# Service entry points; acceptance executables stay local.
/cmd/*
!/cmd/api/
!/cmd/worker/
!/cmd/ops/

# Operational scripts only.
/scripts/*
!/scripts/web-release.py

# Runtime deployment inputs.
/deploy/*
!/deploy/.env.example
!/deploy/Dockerfile.backend
!/deploy/compose.yaml
!/deploy/compose.prod.yaml
!/deploy/nginx/

# Frontend source and build inputs; no generated bundles or review tools.
/web/*
!/web/.dockerignore
!/web/.env.example
!/web/.npmrc
!/web/.nvmrc
!/web/Dockerfile
!/web/index.html
!/web/package.json
!/web/package-lock.json
!/web/tsconfig.json
!/web/vite.config.ts
!/web/src/
!/web/scripts/
/web/scripts/*
!/web/scripts/check-node.cjs

# Other documentation and tests remain available locally, outside the repository.
*.md
*.MD
*.markdown
*.rst
*.adoc
!/README.md
!/README.en.md
# Only the three screenshots referenced by the bilingual READMEs are public.
!/images/
/images/*
!/images/overreview.png
!/images/subscription.png
!/images/paper-reading.png
*_test.go
*.test.*
*.spec.*
testdata/
tests/
__tests__/
/internal/contract/
/internal/integration/
/internal/platform/testguard/

# Secrets, private toolchains, caches and runtime/build artifacts.
.env
.env.*
!.env.example
.cache/
.tools/
.deploy/
node_modules/
dist/
bin/
tmp/
coverage/
coverage.out
test-results/
playwright-report/
__pycache__/
*.pyc
*.log
*.tsbuildinfo
.DS_Store

# Reproducible Agent regression suite (other local suites stay ignored).
!/scripts/test-agent.sh
!/scripts/test-migrations.sh
!/deploy/compose.test.yaml
!/internal/agent/integration_test.go
!/internal/agent/paper_workflow_test.go
!/internal/agent/paper_validation_test.go
!/internal/agent/runtime_test.go
!/internal/agent/round1_test.go
!/internal/agent/paper_document_test.go
!/internal/agent/paper_direct_test.go
!/internal/agent/paper_context_test.go
!/internal/agent/paper_context_budget_test.go
!/internal/platform/testguard/
!/internal/platform/testguard/guard.go
!/web/playwright-agent.config.ts
!/web/vite.agent-test.config.ts
!/web/tests/
/web/tests/*
!/web/tests/agent.spec.ts
!/web/tests/agent-fixtures.ts
!/web/scripts/test-agent.cjs

!/internal/agent/paper_review_test.go
!/internal/ai/paper_budget_test.go
!/internal/platform/llm/paper_budget_test.go
!/internal/bootstrap/paper_budget_test.go
!/internal/agent/paper_policy_test.go
!/internal/generation/paper_schema_test.go
!/internal/agent/paper_version_test.go
!/scripts/test-paper-packages.sh
!/internal/agent/paper_repair_test.go
!/internal/agent/paper_call_reservation_test.go

!/internal/agent/paper_answer_test.go
!/internal/agent/paper_question_test.go
!/internal/agent/paper_supplement_test.go
!/internal/document/paper_retrieval_test.go
!/internal/document/structured_test.go
!/internal/platform/document/structured_html_test.go

!/internal/agent/paper_structured_test.go

!/internal/agent/paper_reproduction_test.go
!/internal/agent/paper_reproduction_workflow_test.go

!/internal/generation/paper_budget_test.go
!/internal/platform/config/paper_budget_test.go
!/internal/agent/paper_recovery_v14_test.go
!/internal/agent/paper_partial_budget_test.go

!/internal/agent/paper_partial_review_packing_test.go
