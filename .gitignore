# Track application source, build inputs, deployment files and the root README.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/.nvmrc
!/Makefile
!/go.mod
!/go.sum
!/cmd/
!/internal/
!/migrations/
!/deploy/
!/scripts/
!/web/

# Service entry points; acceptance executables stay local.
/cmd/*
!/cmd/api/
!/cmd/worker/
!/cmd/ops/

# Operational scripts only.
/scripts/*
!/scripts/web-release.py

# Runtime deployment inputs.
/deploy/*
!/deploy/.env.example
!/deploy/Dockerfile.backend
!/deploy/compose.yaml
!/deploy/compose.prod.yaml
!/deploy/nginx/

# Frontend source and build inputs; no generated bundles or review tools.
/web/*
!/web/.dockerignore
!/web/.env.example
!/web/.npmrc
!/web/.nvmrc
!/web/Dockerfile
!/web/index.html
!/web/package.json
!/web/package-lock.json
!/web/tsconfig.json
!/web/vite.config.ts
!/web/src/
!/web/scripts/
/web/scripts/*
!/web/scripts/check-node.cjs

# Other documentation and tests remain available locally, outside the repository.
*.md
*.MD
*.markdown
*.rst
*.adoc
!/README.md
*_test.go
*.test.*
*.spec.*
testdata/
tests/
__tests__/
/internal/contract/
/internal/integration/
/internal/platform/testguard/

# Secrets, private toolchains, caches and runtime/build artifacts.
.env
.env.*
!.env.example
.cache/
.tools/
.deploy/
node_modules/
dist/
bin/
tmp/
coverage/
coverage.out
test-results/
playwright-report/
__pycache__/
*.pyc
*.log
*.tsbuildinfo
.DS_Store
