# Copy to deploy/.env.production. Never commit the resulting file.
BACKEND_VERSION=initial
BACKEND_ENV_FILE=.env.production
SERVER_NAME=signalwatch.example.com
WEB_ROOT=/srv/signalwatch/web
TLS_CERT_DIR=/srv/signalwatch/certs
# Existing installations: obtain the exact names with docker volume ls/inspect.
# These external volumes must already exist; Compose will not create empty ones.
MYSQL_VOLUME_NAME=signalwatch_mysql_data
REDIS_VOLUME_NAME=signalwatch_redis_data

APP_ENV=production
HTTP_ADDR=0.0.0.0:8080
APP_PUBLIC_URL=https://signalwatch.example.com
LOG_LEVEL=info
WORKER_HEARTBEAT=10s
MYSQL_DATABASE=signalwatch
MYSQL_USER=signalwatch
MYSQL_PASSWORD=replace-app-password
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_DSN=signalwatch:replace-app-password@tcp(mysql:3306)/signalwatch?charset=utf8mb4&parseTime=true&loc=UTC
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5
REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace-redis-password
REDIS_DB=0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_TTL=15m
AUTH_SESSION_TTL=168h
JWT_ISSUER=signalwatch-api
SMTP_ADDR=smtp.example.com:587
SMTP_FROM=SignalWatch <digest@example.com>
SMTP_USERNAME=replace-smtp-user
SMTP_PASSWORD=replace-smtp-password
SMTP_STARTTLS=true
SMTP_TIMEOUT=10s
AI_ENABLED=false
# Copy existing AI policy and encryption key versions here when AI is enabled.
AI_CREDENTIAL_KEYS=
AI_CREDENTIAL_ACTIVE_KEY_VERSION=v1

# Application budgets, not vendor specifications; defaults 32768/8192.
AI_MODEL_LIMITS_JSON=
# Paper model call deadline, 10s–120s.
AI_PAPER_CALL_TIMEOUT=60s
