{
  "name": "signalwatch-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.ts *.html",
    "format:check": "prettier --check src tests scripts *.ts *.html",
    "review:gallery": "node scripts/review-gallery.mjs"
  },
  "dependencies": {
    "lucide-react": "0.563.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
